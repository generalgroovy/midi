  "actions": {
    "browser": [
      "xdg-open",
      "https://www.google.com"
    ],
    "terminal": [
      "foot"
    ],
    "files": [
      "xdg-open",
      "{home}"
    ],
    "launcher": [
      "wofi",
      "--show",
      "drun"
    ],
    "play_pause": [
      "playerctl",
      "play-pause"
    ],
    "next_track": [
      "playerctl",
      "next"
    ],
    "previous_track": [
      "playerctl",
      "previous"
    ],
    "mute_output": [
      "wpctl",
      "set-mute",
      "@DEFAULT_AUDIO_SINK@",
      "toggle"
    ],
    "mute_microphone": [
      "wpctl",
      "set-mute",
      "@DEFAULT_AUDIO_SOURCE@",
      "toggle"
    ],
    "workspace_1": [
      "swaymsg",
      "workspace",
      "number",
      "1"
    ],
    "workspace_2": [
      "swaymsg",
      "workspace",
      "number",
      "2"
    ],
    "workspace_3": [
      "swaymsg",
      "workspace",
      "number",
      "3"
    ],
    "workspace_4": [
      "swaymsg",
      "workspace",
      "number",
      "4"
    ],
    "workspace_next": [
      "swaymsg",
      "workspace",
      "next"
    ],
    "workspace_previous": [
      "swaymsg",
      "workspace",
      "prev"
    ],
    "audio_controls": [
      "pavucontrol"
    ],
    "audio_effects": [
      "easyeffects"
    ],
    "lock_screen": [
      "swaylock",
      "-f"
    ],
    "screenshot": "mkdir -p \"$HOME/Pictures/Screenshots\" && grim -g \"$(slurp)\" \"$HOME/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png\"",
    "custom_script": [
      "{home}/.local/bin/traktor-custom-action",
      "{device}",
      "{control}",
      "{kind}",
      "{value}",
      "{percent}"
    ]
  },
  "bass_presets": [
    "Bass-0",
    "Bass-1",
    "Bass-2",
    "Bass-3",
    "Bass-4",
    "Bass-5",
    "Bass-6",
