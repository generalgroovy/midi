{
  "model_controls": {
    "state_file": "~/.config/traktor-system-controller/model-controls.json",
    "hook": "~/.config/traktor-system-controller/hooks/model-controls-updated",
    "notify": false,
    "debounce_ms": 250,
    "parameters": {
      "temperature": {"min": 0.0, "max": 2.0, "step": 0.01, "default": 0.7, "decimals": 2},
      "top_p": {"min": 0.05, "max": 1.0, "step": 0.01, "default": 0.9, "decimals": 2},
      "repeat_penalty": {"min": 0.8, "max": 1.5, "step": 0.01, "default": 1.1, "decimals": 2},
      "max_tokens": {"min": 128, "max": 8192, "step": 128, "default": 2048, "decimals": 0},
      "context_length": {"min": 1024, "max": 32768, "step": 1024, "default": 8192, "decimals": 0},
      "threads": {"min": 1, "max": 8, "step": 1, "default": 4, "decimals": 0},
      "gpu_layers": {"min": 0, "max": 80, "step": 1, "default": 0, "decimals": 0},
      "seed": {"min": 0, "max": 9999, "step": 1, "default": 0, "decimals": 0}
    }
  }
}
