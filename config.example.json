{
  "_instructions": [
    "Run traktor-system-controller --monitor.",
    "Press or turn one physical control at a time.",
    "Copy its device, channel and note/control number into a mapping below.",
    "Use type 'note' for note_on buttons and 'cc_button' for control_change buttons.",
    "Use cc_mappings for knobs, encoders and faders."
  ],
  "device_aliases": {
    "x1": [
      "Traktor Kontrol X1",
      "Kontrol X1",
      "X1 MK1",
      "X1 MK2",
      "X1 MK3"
    ],
    "f1": [
      "Traktor Kontrol F1",
      "Kontrol F1"
    ]
  },
  "actions": {
    "browser": [
      "firefox"
    ],
    "terminal": [
      "foot"
    ],
    "files": [
      "thunar"
    ],
    "play_pause": [
      "playerctl",
      "play-pause"
    ],
    "next_track": [
      "playerctl",
      "next"
    ],
    "previous_track": [
      "playerctl",
      "previous"
    ],
    "mute_output": [
      "wpctl",
      "set-mute",
      "@DEFAULT_AUDIO_SINK@",
      "toggle"
    ],
    "mute_microphone": [
      "wpctl",
      "set-mute",
      "@DEFAULT_AUDIO_SOURCE@",
      "toggle"
    ],
    "workspace_1": [
      "swaymsg",
      "workspace",
      "number",
      "1"
    ],
    "workspace_2": [
      "swaymsg",
      "workspace",
      "number",
      "2"
    ],
    "lock_screen": [
      "swaylock",
      "-f"
    ]
  },
  "button_mappings": [
    {
      "_replace_this_example": true,
      "device": "f1",
      "type": "note",
      "channel": 0,
      "number": 999,
      "action": "browser"
    },
    {
      "_replace_this_example": true,
      "device": "x1",
      "type": "cc_button",
      "channel": 0,
      "number": 999,
      "action": "play_pause"
    }
  ],
  "cc_mappings": [
    {
      "_replace_this_example": true,
      "device": "f1",
      "channel": 0,
      "number": 999,
      "action": "volume_absolute"
    },
    {
      "_replace_this_example": true,
      "device": "x1",
      "channel": 0,
      "number": 999,
      "action": "volume_relative",
      "relative_mode": "twos-complement"
    },
    {
      "_replace_this_example": true,
      "device": "f1",
      "channel": 0,
      "number": 998,
      "action": "bass_preset_absolute"
    }
  ],
  "bass_presets": [
    "Bass-0",
    "Bass-1",
    "Bass-2",
    "Bass-3",
    "Bass-4",
    "Bass-5",
    "Bass-6",
    "Bass-7"
  ]
}
