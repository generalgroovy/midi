{
  "schema_version": 4,
  "include": [
    "defaults/actions.json",
    "defaults/model.json",
    "defaults/scripts.json",
    "defaults/visuals.json",
    "defaults/f1.json",
    "defaults/x1.json"
  ],
  "active_profile": "linux-ops",
  "profiles": {
    "linux-ops": {
      "description": "Unified F1 desktop/model/script surface and X1 focused-window cockpit with HOTCUE diagnostics; no repeated action signatures per controller."
    },
    "blank": {
      "description": "No mappings."
    }
  },
  "layout_rules": {
    "no_repeated_actions_per_controller": true
  },
  "runtime": {
    "log_actions": true,
    "notify_actions": false
  }
}
