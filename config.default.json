{
  "schema_version": 6,
  "include": [
    "defaults/actions.json",
    "defaults/model.json",
    "defaults/scripts.json",
    "defaults/visuals.json",
    "defaults/f1.json",
    "defaults/x1.json",
    "defaults/autocode.json"
  ],
  "active_profile": "linux-ops",
  "profiles": {
    "linux-ops": {
      "description": "Unified F1 desktop/model/script surface and X1 focused-window cockpit with GUI configuration and monitoring."
    },
    "blank": {
      "description": "No mappings."
    }
  },
  "layout_rules": {
    "no_repeated_actions_per_controller": true
  },
  "runtime": {
    "log_actions": true,
    "notify_actions": false
  },
  "display_controls": {
    "brightness": {
      "backend": "auto",
      "device": "",
      "ddc_display": "",
      "minimum_percent": 1,
      "debounce_ms": 100
    },
    "color_temperature": {
      "backend": "auto",
      "minimum_kelvin": 2500,
      "maximum_kelvin": 6500,
      "adjustment_method": "wayland",
      "debounce_ms": 180,
      "take_ownership": true,
      "reset_at_max": true
    }
  }
}
