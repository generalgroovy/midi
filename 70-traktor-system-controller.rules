# Native Instruments Traktor Kontrol F1 HID and USB output reports
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1120", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="17cc", ATTR{idProduct}=="1120", TAG+="uaccess", MODE="0660"

# Traktor Kontrol X1 MK1. USB access is required for LED-capable raw mode;
# evdev remains available as a fallback when raw USB mode is disabled.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="2305", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="17cc", ATTR{idProduct}=="2305", TAG+="uaccess", MODE="0660"
